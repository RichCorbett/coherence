#!/bin/sh
# Claude Code may reach this through a symlink, so resolve to the real plugin directory first.
f="$0"
while [ -L "$f" ]; do
  d=$(cd "$(dirname "$f")" && pwd)
  l=$(readlink "$f")
  case "$l" in
    /*) f="$l" ;;
    *) f="$d/$l" ;;
  esac
done

# Preflight: the code is TypeScript run directly by node, so it asks node whether it can strip types
# rather than guessing from a version number. The probe gets $limit seconds, so a hung node cannot run
# the hook into its 30-second timeout, which lets the command through.
# There is no git probe. One was tried, on the belief that a git that cannot run is best caught here.
# Under claude plugin eval it found Apple's /usr/bin/git, which the sandbox blocks, although node's own
# git calls worked; so it refused every command where the plugin worked. A broken git fails at the
# first git call, and the PR hook's deadline in src/commands/pr-gate.ts stops a hung one.
# COHERENCE_PROBE_SECONDS exists for the tests, which cannot wait 5 seconds per case. It can only shorten
# the limit: anything but a fraction of a second or a whole 1 to 5 is ignored, so it can never push the
# probes past the hook's timeout or put arbitrary text into the hook's JSON.
limit=5
case "${COHERENCE_PROBE_SECONDS:-}" in
  [1-5] | 0.[0-9] | 0.[0-9][0-9]) limit=$COHERENCE_PROBE_SECONDS ;;
esac

# Runs "$@" with no input or output and returns its exit status, or 137 if it was killed after $limit seconds.
# Probes read /dev/null, so the hook's JSON on stdin reaches main.ts untouched, and the watchdog's
# output is /dev/null too, so a leftover sleep cannot hold the hook's stdout open.
probe() {
  "$@" </dev/null >/dev/null 2>&1 &
  probed=$!
  (
    trap 'kill "$timer" 2>/dev/null; exit 0' TERM
    sleep "$limit" &
    timer=$!
    wait "$timer"
    kill -9 "$probed" 2>/dev/null
  ) </dev/null >/dev/null 2>&1 &
  watchdog=$!
  wait "$probed"
  status=$?
  kill "$watchdog" 2>/dev/null
  wait "$watchdog"
  return $status
} 2>/dev/null # sh reports the kills ("Terminated", "Killed") on stderr, when it reaps each job

missing=
if ! probe node -e 'process.exit(process.features.typescript ? 0 : 1)'; then
  if ! command -v node >/dev/null 2>&1; then
    missing="node is not on PATH; install a current Node, for example with brew install node"
  elif [ "$status" -eq 137 ]; then
    missing="node did not answer within $limit seconds"
  else
    missing="the node on PATH cannot run TypeScript; install a current Node, for example with brew install node"
  fi
fi

if [ -n "$missing" ]; then
  # The PR hook cannot parse its input without node, so it fails closed on any line that mentions gh
  # as a word, in any case (also just after a JSON \n, \t or \r escape), and lets everything else through.
  # Only grep's "no match" lets the line through: a grep that is missing or fails also refuses it.
  if [ "$1" = pr-gate ] && [ $# -eq 1 ]; then
    grep -Eiq '(^|[^[:alnum:]_]|\\[nrt])gh([^[:alnum:]_]|$)' 2>/dev/null
    if [ $? -ne 1 ]; then
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"coherence cannot check this command: %s"}}\n' "$missing"
    fi
    exit 0
  fi
  echo "coherence: $missing" >&2
  exit 4 # Exit.unavailable in src/lib/base-command.ts
fi

exec node "$(cd "$(dirname "$f")" && pwd)/../src/main.ts" "$@"
