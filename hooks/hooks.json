{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr create*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/coherence\" pr-gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
